SELECT
  ?work
  ?workLabel
  ?author
  ?authorLabel
  ?publisher
  ?publisherLabel
  ?publicationDate
  ?isbn
WHERE {
  ?work wdt:P31 wd:Q571;
    wdt:P50 ?author;
    wdt:P123 ?publisher.
  OPTIONAL { ?work wdt:P577 ?publicationDate. }
  OPTIONAL { ?work wdt:P212 ?isbn. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?work
LIMIT 100
