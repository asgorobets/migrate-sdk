{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "demo:telemetry": {
      "cache": false,
      "passThroughEnv": ["OTEL_*", "MIGRATE_DEMO_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "*.tsbuildinfo", ".next/**", "!.next/cache/**"]
    },
    "//#check": {},
    "//#fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:package": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "build:binary": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["BUN_INSTALL_CACHE_DIR"],
      "outputs": ["dist/binary/**"]
    },
    "package:binary": {
      "dependsOn": ["build:binary"],
      "cache": false,
      "outputs": ["dist/distribution/**"]
    },
    "test:binary": {
      "dependsOn": ["package:binary"],
      "cache": false,
      "passThroughEnv": ["BUN_INSTALL_CACHE_DIR"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
