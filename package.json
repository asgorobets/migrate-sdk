{
  "name": "@migrate-sdk/monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/asgorobets/migrate-sdk"
  },
  "scripts": {
    "build": "turbo run build",
    "build-packages": "turbo run build --filter=migrate-sdk --filter=@migrate-sdk/commercetools --filter=@migrate-sdk/workflow-sdk --filter=@migrate-sdk/tui",
    "changeset": "changeset",
    "dev": "turbo run dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check-types": "turbo run check-types",
    "check-types-packages": "turbo run check-types --filter=migrate-sdk --filter=@migrate-sdk/commercetools --filter=@migrate-sdk/workflow-sdk --filter=@migrate-sdk/tui",
    "test": "turbo run test",
    "test-packages": "turbo run test --filter=migrate-sdk --filter=@migrate-sdk/commercetools --filter=@migrate-sdk/workflow-sdk --filter=@migrate-sdk/tui",
    "test:sql:smoke": "node ./scripts/run-sql-smoke-tests.mjs",
    "validate-packages": "turbo run check-types test --filter=migrate-sdk --filter=@migrate-sdk/commercetools --filter=@migrate-sdk/workflow-sdk --filter=@migrate-sdk/tui",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@changesets/cli": "^3.0.1",
    "@effect/tsgo": "0.18.1",
    "@types/papaparse": "^5.5.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "papaparse": "^5.5.3",
    "turbo": "^2.9.16",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "7.8.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  }
}
